<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/medicine_details_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/medicineNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_name"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/medicineStrengthInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_strength"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hint_form" />

        <Spinner
            android:id="@+id/medicineFormSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/form_options" />

        <EditText
            android:id="@+id/medicineNotesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_notes"
            android:inputType="textMultiLine"
            android:maxLines="3" />

        <EditText
            android:id="@+id/startDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_start_date"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/endDateInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_end_date"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false" />

            <Button
                android:id="@+id/clearEndDateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_end_date" />
        </LinearLayout>

        <EditText
            android:id="@+id/stockInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_stock"
            android:inputType="numberDecimal" />

        <CheckBox
            android:id="@+id/activeCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/active_label"
            android:checked="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#DDDDDD" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/alarms_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/sameDoseCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/same_dose_label" />

        <EditText
            android:id="@+id/sameDoseValueInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_same_dose"
            android:inputType="numberDecimal"
            android:text="@string/default_pills" />

        <!-- Alarm rows are added here by the Activity at run time. -->
        <LinearLayout
            android:id="@+id/alarmsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/addAlarmButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_time" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save" />

    </LinearLayout>
</ScrollView>
