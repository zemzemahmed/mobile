<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_settings"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/alarm_timeout_note"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/alertEnabledSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_alert_enabled" />

        <Switch
            android:id="@+id/darkModeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_dark_mode" />

        <Switch
            android:id="@+id/largeTextSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_large_text" />

        <Button
            android:id="@+id/ringtoneButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_ringtone" />

        <Button
            android:id="@+id/caregiversSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/caregivers_button" />

        <Button
            android:id="@+id/rescheduleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_reschedule" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />

    </LinearLayout>
</ScrollView>
